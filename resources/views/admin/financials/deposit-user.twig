{% extends "layouts/app.twig" %}

{% block title %}{{ __('User Deposit') }}{% endblock %}

{% block content %}
<link href="/assets/modules/css/sweetalert2.min.css" rel="stylesheet">
<style>
    .payment-provider-nicky {
        display: inline-block;
        background-image: url('/assets/nicky.svg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    .payment-provider-plata {
        display: inline-block;
        background-image: url('/assets/plata.svg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    [data-bs-theme="dark"] .payment-provider-plata {
        background-image: url('/assets/plata-dark.svg');
    }
    .payment-provider-liqpay {
        display: inline-block;
        background-image: url('/assets/liqpay.svg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    [data-bs-theme="dark"] .payment-provider-liqpay {
        background-image: url('/assets/liqpay-dark.svg');
    }
</style>
      <div class="page-wrapper">
        <!-- Page header -->
        <div class="page-header d-print-none">
          <div class="container-xl">
            <div class="row g-2 align-items-center">
              <div class="col">
                <div class="mb-1">
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                      <a href="{{route('home')}}"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><polyline points="5 12 3 12 12 3 21 12 19 12" /><path d="M5 12v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-8" /><rect x="10" y="12" width="4" height="4" /></svg></a>
                    </li>
                    <li class="breadcrumb-item active">
                      {{ __('User Deposit') }}
                    </li>
                  </ol>
                </div>
                <h2 class="page-title">
                  {{ __('User Deposit') }}
                </h2>
              </div>
            </div>
          </div>
        </div>
        <!-- Page body -->
        <div class="page-body">
          <div class="container-xl">
            <div class="col-12">
            {% include 'partials/flash.twig' %}
              <div class="card">
                <div class="card-body">
                  <form id="depositForm" action="#" method="post">
                  {{ csrf.field | raw }}                 
                    <div class="deposit-info">
                        <h5>{{ __('Current Balance for') }} {{ balance.username }}</h5>
                        <p class="fs-4">{{ currency }} {{ balance.account_balance }}</p>
                    </div>

                    <div class="mb-3">
                        <label for="amount" class="form-label required">{{ __('Amount') }}</label>
                        <input type="number" step="0.01" class="form-control" id="amount" name="amount" placeholder="{{ __('Enter deposit amount') }}" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">{{ __('Payment Method') }}</label>
                        <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column">
                            {% if 'stripe' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="stripe" class="form-selectgroup-input" required>
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-stripe-dark payment-xs me-2"></span>
                                        {{ __('Stripe') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'liqpay' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="liqpay" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-liqpay payment-xs me-2"></span>
                                        {{ __('LiqPay') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'plata' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="plata" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-plata payment-xs me-2"></span>
                                        {{ __('Plata by mono') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'adyen' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="adyen" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-adyen-dark payment-xs me-2"></span>
                                        {{ __('Adyen') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'nicky' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="nicky" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-nicky payment-xs me-2"></span>
                                        {{ __('Crypto') }}: Nicky
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'now' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="now" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-bitcoin-dark payment-xs me-2"></span>
                                        {{ __('Crypto') }}: NOW
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                  <div class="row align-items-center">
                    <div class="d-grid gap-2 d-md-block">
                      <button type="submit" class="btn btn-primary">{{ __('Add Deposit') }}</button>
                    </div>
                  </div>
                </div>
                </form>
                </div>
              </div>
            </div>
          </div>
        </div>
        {% include 'partials/footer.twig' %}
      </div>
<script>
const enabledGateways = {{ enabledGateways|json_encode|raw }};

document.getElementById('depositForm').addEventListener('submit', function (e) {
    e.preventDefault();

    const formData = new FormData(this);
    const paymentMethod = formData.get('paymentMethod');
    const amount = document.getElementById('amount')?.value?.trim();
    if (!amount || isNaN(amount) || parseFloat(amount) <= 0) {
        Swal.fire({
            icon: 'warning',
            title: '{{ __("Invalid Amount") }}',
            text: '{{ __("Please enter a valid deposit amount.") }}'
        });
        return;
    }

    if (!enabledGateways.includes(paymentMethod)) {
        showError('{{ __("Error") }}', '{{ __("This payment method is not available.") }}');
        return;
    }

    if (paymentMethod === 'liqpay') {
        this.action = '/payment/liqpay/create';
        this.method = 'POST';
        this.submit();
        return;
    }

    sendPayment(`/payment/${encodeURIComponent(paymentMethod)}/create`, formData, (data) => {
        window.location.href = data.url;
    });
});

function sendPayment(url, formData, onSuccess) {
    fetch(url, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) {
            console.error(`${url} Error:`, data.error);
            showError('{{ __("Payment Error") }}', data.error);
        } else {
            console.log(`${url} success:`, data);
            onSuccess(data);
        }
    })
    .catch(err => {
        console.error(`Error in ${url}:`, err);
        showError('{{ __("Unexpected Error") }}', '{{ __("An unexpected error occurred. Please try again later. Ensure the payment gateway is properly configured.") }}');
    });
}

function showError(title, text) {
    Swal.fire({ icon: 'error', title, text });
}
</script>
<script src="/assets/modules/js/sweetalert2.min.js" defer></script>
{% endblock %}